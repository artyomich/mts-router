# MTS-MB-3000 Mobile Backhaul Buildroot Configuration
# NXP S32G3 ARM32 processor
# MPLS-TP + PTP grandmaster

# ============================================================
# Target architecture
# ============================================================
BR2_aarch64=y
BR2_aarch64_64=y
BR2_ENDIAN="little"
BR2_HOST_GCC_AT_LEAST_9=y

# ============================================================
# System configuration
# ============================================================
BR2_INIT_SYSV=y
BR2_ROOTFS_SKELETON_DEFAULT=y
BR2_ROOTFS_HOSTNAME="mts-mb3000"
BR2_ROOTFS_OVERLAY="board/mts/s32g3/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/mts/s32g3/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/mts/s32g3/post-image.sh"

# ============================================================
# Kernel
# ============================================================
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="s32g"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="arch/arm/configs/mts-s32g3.cfg"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="fsl-s32g274mdn"
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1.85"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# ============================================================
# Bootloader
# ============================================================
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_FORMAT_BIN=y
