@startuml C2_gRPC_Service_RPC_Methods
' C2: gRPC Service RPC Methods - MTS-MB-3000 Mobile Backhaul
' Redesigned: vertical layout with elements stacked top-to-bottom to avoid arrow overlaps

title MTS-MB-3000 - gRPC Service RPC Methods (Vertical)

skinparam backgroundColor white
skinparam component {
  BackgroundColor #ecf0f1
  BorderColor #2c3e50
  FontColor #2c3e50
}
skinparam arrowColor #34495e
skinparam ArrowFontSize 10

' === TOP: External Client ===
package "External Clients" <<Client>> {
  [NMS/OSS\nClient] as Client
}

' === MIDDLE: gRPC Service Layer ===
package "gRPC Service Layer" <<Service>> {
  
  package "Unary RPC" {
    [GetPtpStatus] as GetPtp
    [GetSyncEStatus] as GetSyncE
    [GetMplsTpPwStatus] as GetMpls
    [GetPortStatus] as GetPort
    [GetDeviceHealth] as GetHealth
    [SetGrandmaster] as SetGM
    [CreatePw] as CreatePw
    [DeletePw] as DeletePw
  }
  
  package "Streaming RPC" {
    [SubscribeTelemetry] as SubTelemetry
  }
}

' === LOWER MIDDLE: HAL Layer ===
package "HAL Layer" <<HAL>> {
  
  package "PtpHal" as PtpHal {
    [getStatus()] as PtpGet
    [setGrandmasterMode()] as PtpSet
  }
  
  package "SyncEHal" as SyncEHal {
    [getStatus()] as SyncGet
    [setMode()] as SyncSet
  }
  
  package "MplsTpHal" as MplsHal {
    [getStatus()] as MplsGet
    [createPw()] as MplsCreate
    [deletePw()] as MplsDelete
  }
}

' === BOTTOM: Protobuf Responses ===
package "Protobuf Responses" <<Proto>> {
  [PtpStatus] as PtpResp
  [SyncEStatus] as SyncResp
  [MplsTpPwStatus] as MplsResp
  [PortStatus] as PortResp
  [DeviceHealth] as HealthResp
  [TelemetryData] as TelemetryResp
}

' === Client to gRPC Service (downward) ===
Client --> GetPtp : Empty()
Client --> GetSyncE : Empty()
Client --> GetMpls : Empty()
Client --> GetPort : Empty()
Client --> GetHealth : Empty()
Client --> SetGM : SetGrandmasterReq
Client --> CreatePw : CreatePwReq
Client --> DeletePw : PwDeleteReq
Client --> SubTelemetry : TelemetrySub

' === gRPC Service to HAL (downward) ===
GetPtp ..> PtpGet : PtpStatus
SetGM ..> PtpSet : configure

GetSyncE ..> SyncGet : SyncEStatus[]

GetMpls ..> MplsGet : MplsTpPwStatus[]
CreatePw ..> MplsCreate : create
DeletePw ..> MplsDelete : delete

SubTelemetry ..> PtpGet : read
SubTelemetry ..> SyncGet : read
SubTelemetry ..> MplsGet : read

' === HAL to Responses (downward) ===
PtpGet --> PtpResp
SyncGet --> SyncResp
MplsGet --> MplsResp
MplsCreate --> MplsResp
MplsDelete --> MplsResp

GetPort --> PortResp
GetHealth --> HealthResp
SubTelemetry --> TelemetryResp

legend right
  *C2: gRPC Service RPC Methods (Vertical)*
  ||
  *Unary RPC (8):*
  1. GetPtpStatus -> PtpHal
  2. GetSyncEStatus -> SyncEHal
  3. GetMplsTpPwStatus -> MplsTpHal
  4. GetPortStatus (local)
  5. GetDeviceHealth (local)
  6. SetGrandmaster -> PtpHal
  7. CreatePw -> MplsTpHal
  8. DeletePw -> MplsTpHal
  ||
  *Streaming RPC (1):*
  1. SubscribeTelemetry (all HAL)
  ||
  *HAL modules:*
  PtpHal, SyncEHal, MplsTpHal
endlegend

@enduml
