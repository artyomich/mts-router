# MTS-MC-5000 Mobile Core API Configuration
# @CMAKE_CONFIG_DIR@/mts-mc5000.conf

[server]
port = 50052
tls_enabled = true
tls_cert = /etc/mts/certs/server.crt
tls_key = /etc/mts/certs/server.key
tls_ca = /etc/mts/certs/ca.crt

[logging]
level = info
file = /var/log/mts-mc5000-api.log

[mtls]
enabled = true
cert_file = /etc/mts/certs/client.crt
key_file = /etc/mts/certs/client.key
ca_file = /etc/mts/certs/ca.crt

[telemetry]
stream_interval_ms = 1000
delta_encoding = true

[hw]
dpdk_socket = 0
dpdk_mbufs = 16384
dpdk_mbuf_size = 4096

[k3s]
enabled = true
kube_config = /etc/rancher/k3s/k3s.yaml
node_name = mts-mc5000

[nrf]
discovery_interval_ms = 30000
registration_ttl = 3600000
priority = 1
capacity = 100

[upf]
max_sessions = 1048576
default_five_qi = 9
pdr_buffer_size = 4096

[smf]
max_sessions = 262144
ip_pool = 10.60.0.0/16
dns_server1 = 8.8.8.8
dns_server2 = 8.8.4.4
