@startuml C4_Linux_Integration_Data_Flow
' C4: Linux Integration & Data Flow
' Vertically compact layered architecture with internal data paths

title MTS-RG-500 - Linux Integration & Data Flow (Compact)

skinparam backgroundColor white
skinparam rectangle {
  BackgroundColor #f8f9fa
  BorderColor #333333
  FontColor #333333
}

' === LAYER 1: External Clients ===
package "External Clients" <<Client>> {
  [NMS/OSS] as NMS
  [Monitoring\nSystem] as Mon
}

' === LAYER 2: gRPC Service ===
package "gRPC Service" <<Service>> {
  rectangle "MtsResidentialServiceImpl" as ServiceImpl {
    [GetWifiStatus] as GetWifi
    [GetVoipStatus] as GetVoip
    [GetIptvStatus] as GetIptv
    [GetGponStatus] as GetGpon
    [GetTr069Status] as GetTr069
    [SubscribeTelemetry] as SubTel
  }
}

' === LAYER 3: HAL Layer ===
package "HAL Layer (C++)" <<HAL>> {
  
  package "WifiHal" as WifiHal {
    [readFromSysfs] as WifiRead
    [parseHostapdLogs] as WifiParse
    [configureWifi] as WifiCfg
  }
  
  package "VoipHal" as VoipHal {
    [readFromSysfs] as VoipRead
    [parseAsteriskLogs] as VoipParse
    [configureCall] as VoipCfg
  }
  
  package "IptvHal" as IptvHal {
    [readFromSysfs] as IptvRead
    [parseIgmpproc] as IptvParse
    [configureChannel] as IptvCfg
  }
  
  package "GponHal" as GponHal {
    [readFromSysfs] as GponRead
    [parseGponConfig] as GponParse
    [configureGpon] as GponCfg
  }
  
  package "Tr069Hal" as Tr069Hal {
    [readFromSysfs] as Tr069Read
    [parseTcpConnections] as Tr069Parse
    [parseCwmpdLogs] as Tr069Log
  }
}

' === LAYER 4: Linux Filesystem ===
package "Linux Filesystem" <<FS>> {
  
  package "sysfs" as Sysfs {
    [/sys/class/ieee80211/] as WifiSysfs
    [/sys/class/thermal/] as TempSysfs
    [/sys/class/power/] as PowerSysfs
    [/sys/class/gpon/] as GponSysfs
  }
  
  package "procfs" as Procfs {
    [/proc/net/dev] as DevProc
    [/proc/net/tcp] as TcpProc
    [/proc/net/igmp] as IgmpProc
  }
}

' === LAYER 5: Linux Kernel ===
package "Linux Kernel 6.x" <<Kernel>> {
  [802.11\nDriver] as WifiDrv
  [Asterisk\nDaemon] as Asterisk
  [ALSA\nSubsystem] as Alsadb
  [IGMP Proxy\nDaemon] as IgmpProxy
  [GPON\nDriver] as GponDrv
  [cwmpd\nDaemon] as Cwmpd
  [Network\nSubsystem] as NetSub
}

' === LAYER 6: Hardware ===
package "MT7981 + RTL960x Hardware" <<HW>> {
  [MT7981\nSoC] as MT7981
  [RTL960x\nGPON PHY] as RtL960
  [WiFi 6\n(802.11ax)] as Wifi6
  [4x GE\nPorts] as GEPorts
  [VoIP\nPHY] as VoIP
}

' === DATA FLOW: Client to Service ===
NMS --> GetWifi : WifiStatus
NMS --> GetVoip : VoipStatus
NMS --> GetIptv : IptvStatus
NMS --> GetGpon : GponStatus
NMS --> GetTr069 : Tr069Status
Mon --> SubTel : TelemetryData[]

' === DATA FLOW: Service to HAL ===
GetWifi ..> WifiRead : WifiStatus
GetVoip ..> VoipRead : VoipStatus
GetIptv ..> IptvRead : IptvStatus
GetGpon ..> GponRead : GponStatus
GetTr069 ..> Tr069Read : Tr069Status
SubTel ..> WifiRead : stream
SubTel ..> VoipRead : stream
SubTel ..> IptvRead : stream
SubTel ..> GponRead : stream
SubTel ..> Tr069Read : stream

' === DATA FLOW: HAL to Filesystem ===
WifiRead --> WifiSysfs : read()
WifiParse --> WifiDrv : tail -f
VoipRead --> DevProc : read()
VoipParse --> Asterisk : AMI query
IptvRead --> DevProc : read()
IptvParse --> IgmpProc : read()
GponRead --> GponSysfs : read()
GponParse --> GponDrv : parse
Tr069Read --> TcpProc : read()
Tr069Parse --> TcpProc : read()
Tr069Log --> Cwmpd : tail -f

' === DATA FLOW: Filesystem to Kernel ===
WifiSysfs --> WifiDrv : kernel interface
DevProc --> NetSub : kernel interface
DevProc --> Asterisk : kernel interface
TcpProc --> Cwmpd : kernel interface
TcpProc --> Asterisk : kernel interface
IgmpProc --> IgmpProxy : kernel interface
GponSysfs --> GponDrv : kernel interface

' === DATA FLOW: Kernel to Hardware ===
WifiDrv --> MT7981 : WiFi frames
WifiDrv --> Wifi6 : WiFi 6
Asterisk --> VoIP : RTP/RTCP
Alsadb --> VoIP : audio
IgmpProxy --> NetSub : multicast
GponDrv --> RtL960 : GPON frames
Cwmpd --> MT7981 : ACS connections
NetSub --> GEPorts : packets

' === Hardware to Kernel ===
Wifi6 ..> WifiDrv : WiFi frames
RtL960 ..> GponDrv : GPON frames
VoIP ..> Asterisk : VoIP audio
GEPorts ..> NetSub : packets
MT7981 ..> WifiDrv : WiFi frames
MT7981 ..> Cwmpd : connections

legend right
  |*C4: Linux Integration & Data Flow (Compact)*|
  ||
  |*6-Layer Architecture (top to bottom):*|
  |1. External Clients (NMS/OSS, Monitoring)|
  |2. gRPC Service (MtsResidentialServiceImpl)|
  |3. HAL Layer (WifiHal, VoipHal, IptvHal, GponHal, Tr069Hal)|
  |4. Linux Filesystem (sysfs, procfs)|
  |5. Linux Kernel (802.11, Asterisk, ALSA, IGMP, GPON, cwmpd)|
  |6. MT7981 + RTL960x Hardware|
  ||
  |*Data Flow (downward):*|
  |Hardware -> Kernel -> sysfs/procfs -> HAL|
  |-> gRPC -> External Clients|
  ||
  |*Control Flow (upward):*|
  |Client -> gRPC -> HAL -> ioctl/hostapd|
  |-> Kernel -> Hardware|
endlegend

@enduml
